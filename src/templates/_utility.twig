{% import '_includes/forms' as forms %}

{% set sitesById = sites|index('id') %}
{% set multiSite = sites|length > 1 %}
{% set noCounts = { pages: 0, urls: 0, variants: 0 } %}
{% set hasVariants = pages|filter(page => page.variant != '')|length > 0 %}

<div id="litespeed-utility">
    <h2>{{ 'Pages sent to LiteSpeed for caching'|t('litespeed') }}</h2>
    <p>{{ 'The pages this website handed to LiteSpeed to keep in its cache, and that haven’t expired yet. LiteSpeed can also drop a page on its own, so check a page below to see whether it really is in the cache.'|t('litespeed') }}</p>

    <div class="tableview">
        <table class="data fullwidth">
            <thead>
                <tr>
                    {% if multiSite %}
                        <th scope="col">{{ 'Site'|t('litespeed') }}</th>
                    {% endif %}
                    <th scope="col">{{ 'Pages'|t('litespeed') }}</th>
                    <th scope="col">{{ 'Unique URLs'|t('litespeed') }}</th>
                    <th scope="col">{{ 'Cookie variants'|t('litespeed') }}</th>
                </tr>
            </thead>
            <tbody>
                {% if multiSite %}
                    {% for site in sites %}
                        {% set counts = stats.sites[site.id] ?? noCounts %}
                        <tr>
                            <th scope="row">{{ site.name|t('site') }}</th>
                            <td>{{ counts.pages|number }}</td>
                            <td>{{ counts.urls|number }}</td>
                            <td>{{ counts.variants|number }}</td>
                        </tr>
                    {% endfor %}
                {% endif %}
                <tr>
                    {% if multiSite %}
                        <th scope="row"><strong>{{ 'All sites'|t('litespeed') }}</strong></th>
                    {% endif %}
                    <td>{{ stats.total.pages|number }}</td>
                    <td>{{ stats.total.urls|number }}</td>
                    <td>{{ stats.total.variants|number }}</td>
                </tr>
            </tbody>
        </table>
    </div>

    <p class="light">{{ 'A page that looks different depending on a cookie is kept once per cookie value: each extra version is a cookie variant.'|t('litespeed') }}</p>

    <hr>

    <h2>{{ 'Check a page'|t('litespeed') }}</h2>

    <form method="get" action="{{ cpUrl('utilities/litespeed') }}">
        {% set queryInput %}
            <div class="flex flex-nowrap">
                <div class="flex-grow">
                    {{ forms.text({
                        id: 'litespeed-query',
                        name: 'q',
                        value: query,
                        placeholder: siteUrl(),
                        code: true,
                    }) }}
                </div>
                <button type="submit" class="btn submit">{{ 'Check'|t('litespeed') }}</button>
            </div>
        {% endset %}

        {{ forms.field({
            label: 'URL'|t('litespeed'),
            instructions: 'Enter a full URL or a path to see whether LiteSpeed has that page in its cache, or part of a URL to search the pages sent to LiteSpeed.'|t('litespeed'),
            id: 'litespeed-query',
        }, queryInput) }}
    </form>

    {% if check %}
        <p class="litespeed-check" role="status">
            <span class="status {{ check.color }}" aria-hidden="true"></span>{{ check.message }}
        </p>
    {% endif %}

    {% if pages is not empty %}
        <div class="tableview litespeed-results">
            <table class="data fullwidth">
                <thead>
                    <tr>
                        <th scope="col">{{ 'URL'|t('litespeed') }}</th>
                        {% if multiSite %}
                            <th scope="col">{{ 'Site'|t('litespeed') }}</th>
                        {% endif %}
                        {% if hasVariants %}
                            <th scope="col">{{ 'Cookies'|t('litespeed') }}</th>
                        {% endif %}
                        <th scope="col">{{ 'Cached since'|t('litespeed') }}</th>
                        <th scope="col">{{ 'Expires'|t('litespeed') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for page in pages %}
                        <tr>
                            <td class="code break-word">{{ page.url }}</td>
                            {% if multiSite %}
                                <td>{{ sitesById[page.siteId].name|t('site') }}</td>
                            {% endif %}
                            {% if hasVariants %}
                                <td class="code break-word">{{ page.variant }}</td>
                            {% endif %}
                            <td class="nowrap">{{ page.dateUpdated|datetime('short') }}</td>
                            <td class="nowrap">{{ page.expiryDate|datetime('short') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% if pages|length >= limit %}
            <p class="light">{{ 'Showing the {limit} most recently cached matches.'|t('litespeed', { limit: limit }) }}</p>
        {% endif %}
    {% elseif query != '' %}
        <p class="litespeed-results">{{ 'No page sent to LiteSpeed matches “{query}”.'|t('litespeed', { query: query }) }}</p>
    {% endif %}

    {% if canPurge %}
        <hr>

        <a class="btn" href="{{ cpUrl('litespeed') }}">{{ 'Purge LiteSpeed cache'|t('litespeed') }}</a>
    {% endif %}
</div>

{% css %}
    #litespeed-utility .litespeed-check,
    #litespeed-utility .litespeed-results {
        margin-top: 24px;
    }
{% endcss %}
